# Copia este archivo como referencia y carga estos valores en:
# Vercel → tu proyecto → Settings → Environment Variables
# NUNCA subas un archivo .env con tus valores reales a GitHub.

MP_ACCESS_TOKEN=      # Access token de PRODUCCIÓN de tu cuenta Mercado Pago
SITE_URL=             # https://tu-dominio.cl (o el dominio .vercel.app mientras no tengas uno propio)
RESEND_API_KEY=       # API key de resend.com
FROM_EMAIL=           # remitente verificado en Resend, ej: ventas@tudominio.cl
DOWNLOAD_SECRET=      # cualquier texto largo y aleatorio, ej genera uno con: openssl rand -hex 32

# --- Panel de administración (/admin) ---
ADMIN_USER=            # el usuario con el que entras al panel admin
ADMIN_PASSWORD=        # tu contraseña del panel admin — cámbiala, no dejes la de ejemplo
ADMIN_SESSION_SECRET=  # otro texto largo y aleatorio, distinto de DOWNLOAD_SECRET

# --- Catálogo editable (opcional pero recomendado) ---
# Sin esto, el panel admin puede VER el catálogo pero no guardar cambios.
# Cuenta gratis en https://upstash.com → crea una base Redis → copia estos dos valores.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
