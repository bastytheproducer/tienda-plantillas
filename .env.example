# Copia este archivo como referencia y carga estos valores en:
# Vercel → tu proyecto → Settings → Environment Variables
# NUNCA subas un archivo .env con tus valores reales a GitHub.

MP_ACCESS_TOKEN=      # Access token de PRODUCCIÓN de tu cuenta Mercado Pago
SITE_URL=             # https://tudominio.vercel.app (o tu dominio propio)
RESEND_API_KEY=       # API key de resend.com
FROM_EMAIL=           # remitente verificado en Resend, ej: pedidos@tudominio.cl
STORE_NOTIFY_EMAIL=   # tu correo real, donde te llegan los pedidos pagados para despachar

# --- Aviso por WhatsApp (gratis vía CallMeBot) ---
# El bot oficial de CallMeBot es +34 644 10 28 72
# Actívalo mandándole "I allow callmebot to send me messages" desde el número
# que quieras usar. CallMeBot te responderá con tu API key.
CALLMEBOT_PHONE=       # tu número, formato 56933489427 (sin +, sin espacios)
CALLMEBOT_APIKEY=      # la API key que te dio el bot

# --- Segundo número para WhatsApp (opcional) ---
# Activa el bot desde el otro número de la misma forma y pon aquí los datos.
CALLMEBOT_PHONE_2=     # (opcional) segundo número, mismo formato
CALLMEBOT_APIKEY_2=    # (opcional) la API key de ese segundo número

# --- Panel de administración (/admin) ---
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=  # texto largo y aleatorio, ej: openssl rand -hex 32

# --- Catálogo editable (opcional pero recomendado) ---
# Sin esto, el panel admin puede VER el catálogo pero no guardar cambios.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
